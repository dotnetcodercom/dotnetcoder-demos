{
  "openapi": "3.2.0",
  "info": {
    "title": "UnionProof | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:46373"
    }
  ],
  "paths": {
    "/pets/dog": {
      "get": {
        "tags": [
          "UnionProof"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          }
        }
      }
    },
    "/pets/cat": {
      "get": {
        "tags": [
          "UnionProof"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          }
        }
      }
    },
    "/pets/echo": {
      "post": {
        "tags": [
          "UnionProof"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pet"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Cat": {
        "required": [
          "name",
          "lives"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "lives": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "Dog": {
        "required": [
          "name",
          "breed"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "breed": {
            "type": "string"
          }
        }
      },
      "Pet": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/Dog"
          },
          {
            "$ref": "#/components/schemas/Cat"
          }
        ]
      }
    }
  },
  "tags": [
    {
      "name": "UnionProof"
    }
  ]
}